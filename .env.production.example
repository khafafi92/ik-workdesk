APP_NAME="Internal 9"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://workdesk.example.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ik_workdesk
DB_USERNAME=ik_workdesk_runtime
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

WORKDESK_BOOTSTRAP_ADMIN_NAME=
WORKDESK_BOOTSTRAP_ADMIN_EMAIL=
WORKDESK_BOOTSTRAP_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
